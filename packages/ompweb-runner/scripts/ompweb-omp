#!/bin/sh
# Dev launcher for the ompweb runner CLI: point ompweb at it with
# `OMP_WEB_OMP_BIN=<repo>/packages/ompweb-runner/scripts/ompweb-omp` to drive a
# source checkout instead of a fetched `ompweb-omp` binary.
#
# It launches Bun the way `packages/coding-agent/scripts/omp` does, and for the
# same reason: Bun evaluates the `preload` entries of the *current working
# directory*'s `bunfig.toml` before the entrypoint, so a runner spawned inside
# an unrelated Bun project would run that project's preload. Bun reads only the
# exact cwd, so the launch happens in an empty bunfig-free directory and the
# preload shim restores the real cwd before import-time snapshots take it.
set -e

# Resolve this script's real location even when invoked through a symlink.
self=$0
while [ -L "$self" ]; do
	link=$(readlink "$self")
	case $link in
	/*) self=$link ;;
	*) self=$(dirname "$self")/$link ;;
	esac
done
scripts_dir=$(CDPATH= cd -- "$(dirname -- "$self")" && pwd -P)
cli=$scripts_dir/../src/cli.ts
preload=$scripts_dir/../../coding-agent/scripts/omp.ts

launch_dir=${OMP_DEV_LAUNCH_DIR:-${HOME}/.omp/.dev-cwd}
[ -d "$launch_dir" ] || mkdir -p "$launch_dir"

OMP_LAUNCH_CWD=$PWD
export OMP_LAUNCH_CWD
cd "$launch_dir"
exec bun --preload "$preload" "$cli" "$@"
